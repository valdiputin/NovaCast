# Biến môi trường NovaCast — copy thành .env (local) hoặc khai báo trong Vercel → Settings → Environment Variables
# Đây là giá trị mẫu, KHÔNG phải secret thật.

# Neon Postgres: chuỗi kết nối pooled (có "-pooler" trong host) — app dùng khi chạy
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon Postgres: chuỗi kết nối trực tiếp (không có "-pooler") — dùng cho prisma migrate / seed
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Khóa ký phiên đăng nhập — chuỗi ngẫu nhiên ≥ 32 ký tự (VD: openssl rand -base64 32)
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu"

# true = bắt buộc nhập OTP khi đăng nhập
OTP_REQUIRED=false
