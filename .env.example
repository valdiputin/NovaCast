# Biến môi trường NovaCast — copy thành .env (local) hoặc khai báo trong Vercel → Settings → Environment Variables
# Đây là giá trị mẫu, KHÔNG phải secret thật.

# Postgres. Trên Vercel, tích hợp Neon tự tạo DATABASE_URL (pooled) và DATABASE_URL_UNPOOLED (trực tiếp);
# script vercel-build tự dùng DATABASE_URL_UNPOOLED khi chạy migration.
# Khi migrate / seed từ máy, dùng chuỗi trực tiếp (không có "-pooler" trong host).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Khóa ký phiên đăng nhập — chuỗi ngẫu nhiên ≥ 32 ký tự (VD: openssl rand -base64 32)
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu"

# true = bắt buộc nhập OTP khi đăng nhập
OTP_REQUIRED=false
